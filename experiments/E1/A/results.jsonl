o, vale de compras ou atividades e serviços que correspondam ao exato valor do depósito [E1-104]. A opção pelo reembolso em numerário não pode ser retirada ou condicionada [E1-104].", "llm_model_returned": "gemma4:12b", "latency_s": 6.06, "load_s": 0.01, "tokens_in": 3202, "tokens_out": 211, "tokens_per_s": 93.4, "done_reason": "stop", "thinking_returned": false, "abstained": false, "abstention_phrase_elsewhere": false, "cited_ids": ["E1-114", "E1-104"], "cited_doc_ids": ["E1-114", "E1-104"], "citations_outside_context": [], "malformed_citations": []}
