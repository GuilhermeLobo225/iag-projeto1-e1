tecimento de água, incluindo as categorias de UD – Social e UD – Emigrante [E1-007].", "llm_model_returned": "gemma4:12b", "latency_s": 4.24, "load_s": 0.01, "tokens_in": 3269, "tokens_out": 203, "tokens_per_s": 94.7, "done_reason": "stop", "thinking_returned": false, "abstained": false, "abstention_phrase_elsewhere": false, "cited_ids": ["E1-103", "E1-007"], "cited_doc_ids": ["E1-103", "E1-007"], "citations_outside_context": [], "malformed_citations": []}
